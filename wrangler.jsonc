{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-emdash-site-new",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aakansha-site",
			"database_id": "69eba752-7c25-43c8-8462-3563ba09e846",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "aakansha-site-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger. Hourly, not every minute: each run boots
	// the full EmDash runtime and does cleanup work, which blows the Free plan
	// 10ms CPU limit. Scheduled posts publish up to an hour late as a result.
	"triggers": {
		"crons": ["0 * * * *"],
	},
}
